
PORT=3000


# ---------------------------------------------------------------- Logging (Grafana Loki, same stack as ep-crm)
# production sets the env="production" Loki label; leave LOG_LEVEL empty for info in production, debug elsewhere.
NODE_ENV=production
LOG_LEVEL=
# From grafana.com > your stack > Loki > Send Logs. Bare origin only, no /loki/api/v1/push.
# Leave LOKI_URL empty to log to stdout only.
LOKI_URL=https://logs-prod-006.grafana.net
LOKI_USERNAME=123456
LOKI_PASSWORD=glc_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------- Mailbox
# The Gmail / Workspace address that receives inquiries. Any address works;
# GMAIL_REFRESH_TOKEN must be created while signed in as this address (checked on boot).
INTAKE_MAILBOX=leads@excellentpublicity.com
# Your company name, used in the AI prompt so the AI never mistakes you for the client.
COMPANY_NAME="Excellent Publicity"

# ---------------------------------------------------------------- Gmail API (Google Cloud)
# OAuth client of type "Desktop" from Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx
# Printed by `npm run authorize` after signing in as INTAKE_MAILBOX.
GMAIL_REFRESH_TOKEN=1//0gxxxxxxxxxxxxxxxxxxxxxxxx
# Label the Gmail filter puts on inquiries. The service only processes mail with this label.
GMAIL_INTAKE_LABEL=Lead-Intake
# Pub/Sub topic Gmail publishes new-mail notifications to.
GMAIL_PUBSUB_TOPIC=projects/your-gcp-project/topics/gmail-leads

# ---------------------------------------------------------------- Pub/Sub push security
# Exactly the push subscription's endpoint URL (also its OIDC audience).
PUBSUB_AUDIENCE=https://your-service.up.railway.app/gmail/push
# The service account the push subscription signs its requests with.
PUBSUB_SERVICE_ACCOUNT=gmail-push@your-gcp-project.iam.gserviceaccount.com

# ---------------------------------------------------------------- AI
# Every Groq model is tried first; OpenRouter models are used when all Groq models are rate-limited or failing.
# Configure either provider or both. Leave a provider's MODELS empty to switch it off.

# Groq: key from https://console.groq.com/keys. Model ids from https://console.groq.com/docs/models
# (replace the example id below with the exact Qwen model id shown there).
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODELS=qwen/qwen3-32b

# OpenRouter: key from https://openrouter.ai/keys. Free models must support structured outputs (see docs/SPEC.md).
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODELS=nvidia/nemotron-3.5-super-vl:free,xingchen-agi/xing4.0-29b-a4b:free,openrouter/free

# round-robin: within each provider, each mail starts at the next model in its list, spreading load.
# fallback:    always start with each provider's first model; the others are used only when it fails.
AI_ROTATION=round-robin
# How long a model that failed (e.g. rate-limited) is skipped, unless the provider says how long to wait.
AI_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------- CRM
CRM_URL=https://crm.excellentpublicity.com
# The CRM's lead import key (the same one the lead generator uses).
LEAD_IMPORT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------- People
# Comma-separated addresses allowed to send inquiries. Mail from anyone else is labelled CRM-Ignored.
ALLOWED_SENDERS=cofounder@excellentpublicity.com
# Receives inquiries the service could not turn into a lead, with the reason.
LEAD_GENERATOR_EMAIL=leadgen@excellentpublicity.com

# ---------------------------------------------------------------- Error alerts
# Comma-separated addresses emailed when something fails (AI, CRM, Gmail, startup).
ALERT_EMAIL=ridham@excellentpublicity.com
# The same error is emailed at most once per this many minutes (0 = every time).
ALERT_THROTTLE_MINUTES=60

# ---------------------------------------------------------------- Processing
# How often to search the mailbox for unprocessed mail (catches missed pushes, retries failures).
SWEEP_INTERVAL_MINUTES=10
# true = no CRM call, no labels, no replies or forwards; payloads are only logged. Error alerts are still sent.
DRY_RUN=true
# true = print each Pub/Sub push to the console and write each fetched mail (headers, body, AI input,
# AI result, checks) to <temp>/ep-lead-intake/<gmail-id>.txt. Contains client data: local debugging only.
DEBUG_DUMP=false
